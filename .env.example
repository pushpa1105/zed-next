# ─────────────────────────────────────────────────────────────
# Environment variables
# Copy to `.env.local` and fill in values. Never commit secrets.
# Every variable must be declared + validated in src/config/env.ts
# ─────────────────────────────────────────────────────────────

# --- Server-only (never exposed to the browser) ---
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Public (inlined into the client bundle at build time) ---
# Canonical public URL of the app (used for metadata, sitemap, OG images)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Tooling ---
# Set to "true" to skip env validation (e.g. Docker image builds)
# SKIP_ENV_VALIDATION=true
